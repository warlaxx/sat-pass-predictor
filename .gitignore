target/
*.class
*.jar
!**/maven-wrapper.jar
.mvn/wrapper/maven-wrapper.jar

# Python (environment of the validation script)
.venv*/
__pycache__/

# Node / Angular
node_modules/
dist/
.angular/
npm-debug.log*

# IDE
.idea/
*.iml
.vscode/
.DS_Store
.neon
.env.local

.env.*.local
