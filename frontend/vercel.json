{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "installCommand": "npm install -g npm@12 && npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/frontend/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://sat-pass-predictor-api.onrender.com/api/:path*"
    },
    {
      "source": "/tle-upstream/NORAD/elements/gp.php",
      "destination": "https://celestrak.org/NORAD/elements/gp.php"
    },
    {
      "source": "/commons-images/:path*",
      "destination": "https://upload.wikimedia.org/:path*"
    },
    {
      "source": "/status-probe/health",
      "destination": "https://sat-pass-predictor-api.onrender.com/actuator/health"
    },
    {
      "source": "/fr",
      "destination": "/fr/index.csr.html"
    },
    {
      "source": "/fr/:path*",
      "destination": "/fr/index.csr.html"
    },
    {
      "source": "/((?!api/|tle-upstream/|status-probe/|commons-images/|fr/).*)",
      "destination": "/index.csr.html"
    }
  ],
  "headers": [
    {
      "source": "/media/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/fr/media/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*).(js|css)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
