# The Docker counterpart of vercel.json: static files, long-lived caching for the
# fingerprinted bundle, and /api forwarded server-side so the browser only ever talks to
# one origin - which is why the API needs no CORS configuration here either.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The first request after start-up fetches a TLE and propagates a whole window;
        # nginx's 60 s default is enough, but say so rather than rely on it.
        proxy_read_timeout 60s;
    }

    # The status page's probe: the backend's health, and nothing else of the actuator.
    # An exact match, so /actuator/metrics stays unreachable through this origin.
    location = /status-probe/health {
        proxy_pass ${API_UPSTREAM}/actuator/health;
        proxy_set_header Host $host;
        proxy_read_timeout 60s;
    }

    # The objects' photographs (ABD-47), fetched from Wikimedia by this server rather than
    # by the browser. ^~ so that no regex rule below wins.
    location ^~ /commons-images/ {
        proxy_pass https://upload.wikimedia.org/;
        proxy_set_header Host upload.wikimedia.org;
        proxy_ssl_server_name on;
        proxy_set_header User-Agent "NextPass/1.0 (https://www.nextpass.space/legal)";
        add_header Cache-Control "public, max-age=604800";
    }

    location ~* \.(?:js|css)$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location ~ ^(/fr)?/media/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # main.ts injects Vercel Web Analytics, whose script only exists on Vercel. Outside it
    # the request is a guaranteed 404 and a red line in every visitor's console; an empty
    # answer lets the script tag load nothing, and no analytics leave the machine.
    # ^~ so that the .js rule below, a regex, does not take precedence over this prefix.
    location ^~ /_vercel/ {
        access_log off;
        return 204;
    }

    # A prerendered page is a file (satellites/index.html); any other path is the app's,
    # not a 404, and gets the shell that renders in the browser. index.html cannot be that
    # shell any more: it is the prerendered home page. French is its own build, under /fr/.
    location /fr/ {
        try_files $uri $uri/ /fr/index.csr.html;
    }

    location = /fr {
        try_files /fr/index.html =404;
    }

    location / {
        try_files $uri $uri/ /index.csr.html;
    }
}
